    {
      "kind": "chapter",
      "title": "The tech in focus",
      "beats": [
        {
          "narration": "Cash goes in at a corner shop, travels as a text, and comes out hundreds of kilometres away.",
          "visual": {
            "type": "ui",
            "variant": "notify",
            "app": "M-Pesa",
            "lines": [
              "You received KSh 2,000 from Amina",
              "Balance: KSh 5,450",
              "Withdraw at any agent near you"
            ]
          }
        },
        {
          "narration": "No bank branch, no account book. Just a basic phone.",
          "visual": {
            "type": "device",
            "kind": "phone",
            "query": "hands typing basic mobile phone"
          }
        }
      ]
    },
    {
      "kind": "chapter",
      "title": "The problem it solves",
      "beats": [
        {
          "narration": "Before 2007, sending money home meant a long bus ride or a costly transfer office.",
          "visual": {
            "type": "stat",
            "value": 194000,
            "label": "households left extreme poverty",
            "source": "Suri & Jack, Science, 2016",
            "query": "rural village road"
